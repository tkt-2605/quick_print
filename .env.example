# Copy to .env and fill in. Both the server and the print agent read this file.

SHOP_NAME=QuickPrint
PORT=4000

# Shown on Contact / Terms / Refund pages. Payment gateways check these before approving you.
# SHOP_LEGAL_NAME = the name on your PAN / bank account (e.g. proprietor's name or registered shop name)
SHOP_LEGAL_NAME=
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=Mon–Sat 9:00 AM – 8:30 PM, Sunday closed
# Days uncollected prints are kept at the counter
PICKUP_HOLD_DAYS=7

# Admin dashboard password (/admin). CHANGE THIS.
ADMIN_PASSWORD=change-me

# Shared secret between server and print agent. Use a long random string.
AGENT_TOKEN=change-me-too

# Where the customer site lives (GitHub Pages). Allows it to call this server.
CORS_ORIGINS=https://quickprint.thiruvengadam.me

# counter  = customers pay cash/UPI at the shop, staff taps "Paid" (default without gateway keys)
# razorpay = online payment (set automatically when the keys below are filled in)
# mock     = developer testing only: fake "pay" button
PAYMENT_MODE=counter

# Razorpay keys (later, after approval).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: path to LibreOffice soffice.exe to accept Word/Excel/PowerPoint files.
# Auto-detected from C:\Program Files\LibreOffice if not set.
SOFFICE_PATH=

# --- Print agent ---
# Where the agent finds the server (same PC: http://localhost:4000)
SERVER_URL=http://localhost:4000
# Auto-detected from %LOCALAPPDATA%\SumatraPDF or Program Files if not set.
SUMATRA_PATH=
# 1 = don't actually print; write each print pass to data/agent-out as PDF instead.
AGENT_DRY_RUN=0
